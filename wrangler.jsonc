{
  // Cloudflare Workers config: serves the static site in ./public and
  // handles the enquiry form at /api/enquiry (worker.js). Enquiries are
  // emailed via Cloudflare Email Routing (send_email binding "SEB"); any
  // photos or videos attached are stored in the R2 bucket (binding "UPLOADS")
  // and a private download link is included in the email.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scouts",
  "compatibility_date": "2026-09-01",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "send_email": [
    { "name": "SEB", "destination_address": "ahtismaly@gmail.com" }
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "scouts-uploads" }
  ]
}
